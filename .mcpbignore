# Excluir SOLO del nivel raíz del repo (patrones anclados con '/'), para NO
# tocar node_modules/ — ahí va el vendor (chrome-devtools-mcp), que DEBE
# viajar dentro del .mcpb. Un patrón sin anclar como 'cli.js' o 'bin' también
# tocaría node_modules/chrome-devtools-mcp/build/src/bin/ y rompería el bundle.
/.git/
/.github/
/.claude/
/tests/
/docs/
/cli.js
/.gitignore
/.npmignore
/.mcpbignore
/.mcp.json
/browser_config.json
/cdp_info.json
/.DS_Store
/*.log
/*.png
/*.txt
